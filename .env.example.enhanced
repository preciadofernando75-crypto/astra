# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://astra:astra-password@localhost:5432/astra_db
# Or for SQLite: DATABASE_URL=sqlite:///astra.db

# Server Configuration
PORT=5000
HOST=127.0.0.1

# Pinecone Configuration (for RAG)
PINCONE_API_KEY=your_pinecone_api_key
PINCONE_ENVIRONMENT=your_environment

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=uploads
